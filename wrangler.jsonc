{
  // The Front Desk, live. A Worker — not a static-assets site — because the page
  // is computed per request: the board's age is measured against the reader's
  // clock, which a build-time render structurally cannot do.
  "name": "bounded-desk",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-21",

  // The DNS record is created by this attach — there is no separate console step and no
  // terraform record. Note for the FIRST deploy: a first custom-domain attach preflights
  // GET /zones/{id}/workers/routes, which an account-only token answers with 10000, while
  // REdeploys of an already-attached domain never touch the zone at all. That asymmetry is
  // why other lanes' redeploys "proved" domains worked while first attaches still failed —
  // so the broker entry for this repo must carry `domains` (the zone-READ groups), not just
  // `scripts`. See WORKERS_DEPLOY_PERMISSION_VARS in the broker.
  //
  // FOUR HOSTS, ONE WORKER, selected by hostname in src/worker.js — one question
  // per host (#7). Splitting them into four Workers would mean four deploys, four
  // broker entries and four chances for the selection rules to drift apart; the
  // rules are the product, so they stay in one place and the hostname picks the
  // page. Each of `issues` and `claims` is a FIRST ATTACH on the next deploy, so
  // that run needs the `domains` group the broker entry already carries (see the
  // note above — this is exactly the first-attach asymmetry).
  "routes": [
    {
      // The front door: an overview of all three, and the default for any other
      // hostname this Worker answers on.
      "pattern": "desk.bounded.tools",
      "custom_domain": true
    },
    {
      // The ranked claimable queue — what used to be served at desk (#7).
      "pattern": "issues.bounded.tools",
      "custom_domain": true
    },
    {
      // What is already spoken for. Split off the issue queue (#7) so that page
      // answers only "what should I pick up".
      "pattern": "claims.bounded.tools",
      "custom_domain": true
    },
    {
      // prs.bounded.tools (#480/#713) — the open-PR list.
      "pattern": "prs.bounded.tools",
      "custom_domain": true
    }
  ],

  // The filtered feed, published by bounded-systems/front-desk-feed — a repo that
  // exists to do exactly this one thing, so the cosign identity a verifier pins
  // names one workflow rather than twenty unrelated ones. The `feed` branch is a
  // single parentless commit, force-pushed hourly.
  //
  // The Worker refuses to render anything that does not identify itself as the
  // `front-desk-public` feed, so pointing this at the wrong place — the private
  // projection above all — fails closed rather than leaking private issue titles.
  // ── NOT YET DECLARED: the subscription store and the VAPID keypair (#37) ──
  //
  // Both need account access this repo's CI does not have, so they are listed
  // here rather than attempted. Until they exist, /subscribe answers 503 and
  // the opt-in says plainly that no signing key is configured — the Worker
  // deploys and works, it just cannot notify anyone yet.
  //
  //   1. A KV namespace, then the binding:
  //        wrangler kv namespace create SUBSCRIPTIONS
  //        "kv_namespaces": [{ "binding": "SUBSCRIPTIONS", "id": "<the id>" }]
  //      Declaring the binding with a placeholder id would fail every deploy of
  //      the whole Worker, which is why it is absent rather than stubbed.
  //
  //   2. The VAPID keypair, generated ONCE and locally — the private half must
  //      never pass through a workflow log or an agent session:
  //        npx web-push generate-vapid-keys
  //        wrangler secret put VAPID_PRIVATE_KEY     # the 32-byte scalar
  //      then the PUBLIC half as a var below (it is not a secret — it is served
  //      to every visitor inside /notify.js):
  //        "VAPID_PUBLIC_KEY": "<the 65-byte point, base64url>"
  //      and a contact the push service can reach:
  //        "VAPID_SUBJECT": "mailto:…"
  //
  // ROTATING THE PUBLIC KEY INVALIDATES EVERY STORED SUBSCRIPTION — a browser
  // binds each one to the applicationServerKey it was created with, so there is
  // no two-slot overlap the way rotate-lease-key has, and every device must
  // re-subscribe. Rotate on actual disclosure, not on a cadence.

  "vars": {
    "FEED_URL": "https://raw.githubusercontent.com/bounded-systems/front-desk-feed/feed/front-desk-public.json",
    // The PR feed, published by the SAME front-desk-feed run as the desk feed
    // (scripts/prs.sh) — the Worker refuses to render it anywhere but the prs
    // host, and refuses any feed that does not name itself front-desk-prs-public.
    "PRS_FEED_URL": "https://raw.githubusercontent.com/bounded-systems/front-desk-feed/feed/front-desk-prs.json",
    "DESK_LIMIT": "25"
  }

  // Route + DNS are created by the custom-domain attach above; issues. and claims.
  // do not resolve until the first deploy carrying this file runs.
}
